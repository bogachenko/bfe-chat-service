[Unit]
Description=BFE Chat Backend (test)
Wants=network-online.target
After=network-online.target postgresql.service bfe-drive.service

[Service]
Type=simple
User=bfe-chat
Group=bfe-chat
WorkingDirectory=/var/lib/bfe-chat-service
EnvironmentFile=/etc/bfe-chat-service/runtime.env
ExecStart=/usr/local/bin/bfe-chat-service -listen=127.0.0.1:8081 -public-origin=${BFE_CHAT_PUBLIC_ORIGIN} -drive-auth-uds=${BFE_CHAT_DRIVE_AUTH_UDS} -migrations=/var/lib/bfe-chat-service/migrations
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/bfe-chat-service
# IMPORTANT: permit actual BFE Drive auth UDS parent directory in sandbox design.

[Install]
WantedBy=multi-user.target
